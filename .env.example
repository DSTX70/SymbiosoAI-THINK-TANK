# Database
DATABASE_URL=your_database_url_here

# Design Token Sync Configuration
# Repository containing your design tokens (can be public or private)
TOKENS_REPO=https://github.com/your-org/symbiosoai-design-tokens.git
# Branch to sync from (defaults to "main")
TOKENS_BRANCH=main
# GitHub token for private repos (leave empty for public repos)
GITHUB_TOKEN=your_github_token_here
# Alternative token env var name
PAT=your_personal_access_token_here

# OAuth Configuration
OAUTH_PROVIDER_NAME=Replit Auth
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_DISCOVERY_URL=your_oauth_discovery_url

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Local Development
BYPASS_AUTH=false
USE_MEMORY_STORAGE=false
# Demo login (production disabled by default)
# Set one of these to 'true' to enable /api/demo-login in production.
DEMO_LOGIN_ENABLED=false
ENABLE_DEMO_LOGIN=false

# Stripe Configuration (for billing and marketplace)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Security Configuration
JWT_SECRET=your_jwt_secret_for_tokens_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Webhook Configuration
WEBHOOK_SECRET=your_general_webhook_secret_here

# Redis Configuration (for BullMQ job processing)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# SSE Streaming
SSE_RETRY_MS=3000

# Sprint 5 - SAML Configuration
SAML_METADATA_URL=https://your-idp.com/metadata
SAML_ENTITY_ID=urn:symbiosoai:saml:entity
SAML_ASSERTION_CONSUMER_SERVICE_URL=https://your-app.com/saml/acs
SAML_CERT_FINGERPRINT=your_cert_fingerprint_here
SAML_DEV_MODE=false

# Sprint 5 - SCIM Configuration  
SCIM_BEARER_TOKEN=your_scim_bearer_token_here

# Sprint 5 - Retention Configuration
RETENTION_DEFAULT_DAYS=90
RETENTION_PURGE_CRON=0 2 * * *

# Sprint 5 - i18n Configuration
I18N_DEFAULT_LOCALE=en

# ============================================
# SPRINT 6 - ENTERPRISE FEATURES V2
# ============================================

# Tenant Hardening & Multi-tenancy
REQUIRE_ORG_HEADER=false  # Set to 'true' to enforce X-Organization-Id header validation
RLS_ENABLED=false         # Set to 'true' when PostgreSQL RLS policies are implemented

# Workflow Automation System
WORKFLOW_WEBHOOK_SECRET=your_workflow_webhook_secret_key_for_external_triggers
WORKFLOW_MAX_RETRIES=3
WORKFLOW_POLL_INTERVAL_MS=5000

# Organization Insights & Analytics
INSIGHTS_DAILY_REPORT_HOUR=6        # Generate daily reports at 6 AM
INSIGHTS_RETENTION_DAYS=365         # Keep insights data for 1 year
INSIGHTS_POLL_INTERVAL_MS=60000     # Update analytics every minute

# Enhanced Analytics
ANALYTICS_ENABLED=true
METRICS_RETENTION_DAYS=90
USAGE_TRACKING_ENABLED=true

# Template Publishing System
TEMPLATE_APPROVAL_REQUIRED=false    # Set to 'true' to require approval before publishing
TEMPLATE_VERSION_LIMIT=10           # Maximum versions per template

# Feature Flags for Sprint 6
TEMPLATE_BUILDER_ENABLED=true
TEMPLATE_PUBLISHING_ENABLED=true
WORKFLOW_AUTOMATION_ENABLED=true
ORGANIZATION_INSIGHTS_ENABLED=true
TENANT_HARDENING_ENABLED=true
ENHANCED_ANALYTICS_ENABLED=true
