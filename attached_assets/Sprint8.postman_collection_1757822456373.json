{
  "info": {
    "name": "SymbiosoAi Sprint 8",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ops/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ops",
            "health"
          ]
        }
      }
    },
    {
      "name": "Echo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ops/echo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ops",
            "echo"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"ping\": \"pong\"}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}